#include <stdio.h>

#define MAX 50

void fifo(int pages[], int n, int f) {
    int frame[f], i, j, k=0, faults=0;

    for(i=0;i<f;i++) frame[i]=-1;

    for(i=0;i<n;i++) {
        int found=0;
        for(j=0;j<f;j++)
            if(frame[j]==pages[i]) found=1;

        if(!found) {
            frame[k]=pages[i];
            k=(k+1)%f;
            faults++;
        }
    }
    printf("FIFO Page Faults = %d\n", faults);
}

// LRU + Optimal omitted for brevity in viva file? No — included:
void lru(int pages[], int n, int f) {
    int frame[f], time[f], count=0, faults=0;

    for(int i=0;i<f;i++) frame[i]=-1;

    for(int i=0;i<n;i++) {
        int found=0;
        for(int j=0;j<f;j++) {
            if(frame[j]==pages[i]) {
                count++;
                time[j]=count;
                found=1;
            }
        }

        if(!found) {
            int min=0;
            for(int j=1;j<f;j++)
                if(time[j]<time[min]) min=j;

            frame[min]=pages[i];
            count++;
            time[min]=count;
            faults++;
        }
    }
    printf("LRU Page Faults = %d\n", faults);
}

void optimal(int pages[], int n, int f) {
    int frame[f], faults=0;

    for(int i=0;i<f;i++) frame[i]=-1;

    for(int i=0;i<n;i++) {
        int found=0;
        for(int j=0;j<f;j++)
            if(frame[j]==pages[i]) found=1;

        if(!found) {
            int idx=-1, farthest=i+1;

            for(int j=0;j<f;j++) {
                int k;
                for(k=i+1;k<n;k++)
                    if(frame[j]==pages[k]) break;

                if(k>farthest) {
                    farthest=k;
                    idx=j;
                }
            }

            if(idx==-1) idx=0;
            frame[idx]=pages[i];
            faults++;
        }
    }
    printf("Optimal Page Faults = %d\n", faults);
}

int main() {
    int n,f;
    printf("Enter number of pages: ");
    scanf("%d",&n);

    int pages[n];
    for(int i=0;i<n;i++) scanf("%d",&pages[i]);

    printf("Enter frames: ");
    scanf("%d",&f);

    fifo(pages,n,f);
    lru(pages,n,f);
    optimal(pages,n,f);
}
